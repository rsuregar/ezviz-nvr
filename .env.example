# --- API (apps/api) ---
LISTEN_ADDR=:8080
MYSQL_DSN=nvr:nvr@tcp(127.0.0.1:3306)/nvr?charset=utf8mb4&parseTime=True&loc=UTC
JWT_SECRET=change-me-in-production
STORAGE_ENCRYPTION_KEY=

# live view (MediaMTX) — no shared secret needed, auth is per-request via /api/mediamtx/auth
MEDIAMTX_HLS_BASE_URL=http://localhost:8888
RETENTION_INTERVAL_MINUTES=60

# Google Drive "Connect" OAuth flow (Google Cloud Console: OAuth client, Drive API enabled)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8080/api/oauth/google/callback
WEB_BASE_URL=http://localhost:3000

# --- Web (apps/web) ---
VITE_API_BASE_URL=http://localhost:8080

# --- Edge agent (apps/edge-agent), one per site ---
API_BASE_URL=http://localhost:8080
AGENT_TOKEN=
RECORD_DIR=./recordings
SEGMENT_SECONDS=600
POLL_INTERVAL_SECONDS=30

# live view push target (central MediaMTX) — leave MEDIAMTX_HOST empty to disable live push.
# Publishes authenticate with this site's own AGENT_TOKEN above, no separate secret needed.
MEDIAMTX_HOST=localhost:8554
